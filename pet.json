{
  "id": "professor-cluckshot",
  "displayName": "Professor Cluckshot",
  "description": "A hoop-loving research chicken who runs simulations, checks evidence, and drops random thesis pep talks.",
  "spriteVersionNumber": 2,
  "spritesheetPath": "spritesheet.webp",
  "animation": {
    "autoDetectFrames": true,
    "idleSlowdown": 6,
    "states": {
      "idle": { "row": 0, "durationMs": 150, "lastFrameDurationMs": 320 },
      "running-right": { "row": 1, "durationMs": 120, "lastFrameDurationMs": 220 },
      "running-left": { "row": 2, "durationMs": 120, "lastFrameDurationMs": 220 },
      "waving": { "row": 3, "durationMs": 120, "lastFrameDurationMs": 240 },
      "jumping": { "row": 4, "durationMs": 140, "lastFrameDurationMs": 280 },
      "failed": { "row": 5, "durationMs": 140, "lastFrameDurationMs": 240 },
      "waiting": { "row": 6, "durationMs": 150, "lastFrameDurationMs": 260 },
      "running": { "row": 7, "durationMs": 120, "lastFrameDurationMs": 220 },
      "review": { "row": 8, "durationMs": 150, "lastFrameDurationMs": 280 }
    },
    "chains": {
      "idle": ["idle", "idle", "waving", "idle", "review", "idle", "jumping", "idle"],
      "running": { "mode": "loop", "sequence": ["running", "review", "running", "waving", "running"] },
      "review": ["review", "waving", "idle"],
      "waiting": ["waiting", "waving", "idle"],
      "failed": ["failed", "waiting", "idle"],
      "jumping": ["jumping", "waving", "idle"]
    },
    "events": {
      "hover": "waving",
      "dragLeft": "running-left",
      "dragRight": "running-right",
      "dragUp": "waving",
      "dragDown": "jumping"
    }
  }
}
